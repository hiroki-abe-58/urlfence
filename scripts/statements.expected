STATEMENT UrlFence.parse_authority : ∀ (s : List Char) (u : UrlFence.Url), UrlFence.parse s = Except.ok u → List.takeWhile (fun c => !UrlFence.isDelim c) (List.drop u.scheme.pre.length s) = u.host.render ++ UrlFence.portPart u.port ∧ (u.rest = [] ∨ ∃ c t, u.rest = c :: t ∧ (c = '/' ∨ c = '?' ∨ c = '#'))
