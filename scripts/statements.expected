STATEMENT UrlFence.check_allow_iff : ∀ (pol : UrlFence.Policy) (s : List Char) (u : UrlFence.Url), pol.check s = UrlFence.Decision.allow u ↔ UrlFence.parse s = Except.ok u ∧ u.scheme ∈ pol.schemes ∧ (∃ p, p ∈ pol.allow ∧ p.matches u.host = true) ∧ ∀ (p : UrlFence.Pattern), p ∈ pol.deny → p.matches u.host = false
